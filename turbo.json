{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "release:package": {
      "cache": false
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "doc_build/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "doc_build/**"]
    },
    "//#test:tooling": {
      "cache": false
    }
  }
}
