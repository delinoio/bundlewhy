{
  "name": "bundlewhy-workspace",
  "private": true,
  "license": "Apache-2.0",
  "packageManager": "pnpm@10.26.2",
  "scripts": {
    "prepare": "./scripts/install-git-hooks.sh",
    "test": "turbo run test",
    "format": "node scripts/ci/format-changed.mjs --write",
    "format:check": "node scripts/ci/format-changed.mjs",
    "test:tooling": "node --test scripts/ci/*.test.mjs",
    "build": "turbo run build",
    "dev:public-docs": "pnpm --filter bundlewhy-docs dev",
    "proto:generate": "buf generate",
    "proto:lint": "buf lint && buf format --diff --exit-code"
  },
  "devDependencies": {
    "lefthook": "2.2.2",
    "rstack": "0.8.3",
    "@bufbuild/buf": "1.72.0",
    "@bufbuild/protoc-gen-es": "2.14.0",
    "@connectrpc/protoc-gen-connect-query": "2.3.1",
    "turbo": "2.9.18"
  },
  "pnpm": {
    "overrides": {
      "@stoplight/spectral-core>minimatch": "3.1.5",
      "axios": "1.16.0",
      "basic-ftp": "5.3.1",
      "brace-expansion@>=1.0.0 <1.1.16": "1.1.21",
      "brace-expansion@>=2.0.0 <2.1.2": "5.0.12",
      "brace-expansion@>=5.0.0 <5.0.8": "5.0.12",
      "engine.io>cookie": "0.7.2",
      "esbuild": "0.28.2",
      "express": "4.22.3",
      "fast-uri": "3.1.9",
      "follow-redirects": "1.16.1",
      "form-data": "4.0.6",
      "http-proxy-agent>@tootallnate/once": "3.0.1",
      "ip-address": "10.7.4",
      "js-yaml": "4.3.2",
      "lodash": "4.18.1",
      "path-to-regexp": "0.1.13",
      "postcss": "8.5.28",
      "qs": "6.16.0",
      "react-router-dom": "7.18.4",
      "shell-quote": "1.9.0",
      "uuid": "11.1.1",
      "ws@>=6.0.0 <6.2.4": "6.2.6",
      "ws@>=7.0.0 <7.5.11": "7.5.13",
      "ws@>=8.0.0 <8.21.0": "8.21.3"
    }
  }
}
